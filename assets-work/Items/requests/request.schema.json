{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MU item regeneration request",
  "description": "request.json of one folder under assets-work/Items/requests/<id>/. Contract and field ownership: README.md next to this file. Every path is relative to the repository root. validate_request.py checks this shape plus the rules a schema cannot express (paths exist, id/branch/folder agree, targets match catalog.json, scope and must_keep for the kind, base_commit/start_commit and the worker's changes, delivered originals and exports, capture and reference image sizes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "created", "author", "status", "status_history", "priority", "kind",
    "base_commit", "targets", "change", "constraints", "evidence", "handoff", "result", "decision"
  ],
  "properties": {
    "schema": { "const": "mu-item-regen-request/1" },
    "id": { "$ref": "#/$defs/requestId" },
    "created": { "$ref": "#/$defs/timestamp" },
    "author": { "type": "string", "minLength": 1, "description": "\"owner (item editor)\" when the editor files it." },
    "status": { "$ref": "#/$defs/status" },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "description": "Append-only; the first entry is open and the last entry's status equals status.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "at", "by"],
        "properties": {
          "status": { "$ref": "#/$defs/status" },
          "at": { "$ref": "#/$defs/timestamp" },
          "by": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "priority": { "enum": ["low", "normal", "high"] },
    "kind": {
      "enum": ["upscale", "repaint", "remodel", "redesign", "set"],
      "description": "upscale/repaint change textures only; remodel/redesign may replace BMDs and textures; set applies change.set_kind to every part of one armour set."
    },
    "base_commit": { "$ref": "#/$defs/commit" },
    "supersedes": {
      "description": "Optional id of an earlier request this one replaces.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/requestId" }]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "description": "The items to change; the first one names the folder (<date>-<item-key>-<slug>).",
      "items": { "$ref": "#/$defs/target" }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "details", "keep", "avoid"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "details": { "$ref": "#/$defs/stringList" },
        "keep": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "set_kind": {
          "enum": ["upscale", "repaint", "remodel", "redesign"],
          "description": "kind set only: what is done to every part."
        },
        "reference_images": {
          "type": "array",
          "description": "Owner's reference images, copied into the request's captures/ as ref-*.jpg.",
          "items": { "type": "string", "pattern": "^assets-work/Items/requests/[^/]+/captures/ref-[^/]+\\.(jpg|jpeg)$" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_textures", "frozen_textures", "owned_files", "protected_paths", "limits", "must_keep"],
      "properties": {
        "shared_textures": {
          "type": "object",
          "description": "Every target texture container used by another consumer -> all its consumers (item keys and other:<MODEL>), including the targets, sorted as in catalog.json.",
          "propertyNames": { "$ref": "#/$defs/containerPath" },
          "additionalProperties": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        },
        "frozen_textures": {
          "type": "array",
          "description": "Containers that must stay byte-identical: at least every shared container with a consumer outside the targets.",
          "items": { "$ref": "#/$defs/containerPath" }
        },
        "owned_files": {
          "type": "array",
          "description": "The only game files the worker may replace: the targets' BMDs (remodel, redesign) and non-frozen texture containers.",
          "items": { "$ref": "#/$defs/gamePath" }
        },
        "protected_paths": {
          "type": "array",
          "description": "Files or folder prefixes (ending in /) that must not change.",
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_triangles", "max_texture_size"],
          "properties": {
            "max_triangles": { "const": 1500 },
            "max_texture_size": { "const": 1024 }
          }
        },
        "must_keep": {
          "type": "array",
          "minItems": 1,
          "description": "The README's common list plus the lines of the kind (for set: of set_kind, plus the set line).",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captures", "offline_previews"],
      "properties": {
        "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "offline_previews": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "branch", "worktree", "deliver_to", "push_allowed", "claimed_by", "claimed_at", "start_commit"],
      "properties": {
        "repo": { "const": "vaskodagamo/MuMain" },
        "branch": { "type": "string", "pattern": "^codex/item-req-[0-9]{1,2}-[0-9]{1,3}(-[a-z0-9]+){1,5}$" },
        "worktree": { "type": "string", "pattern": "^\\.\\./MuMain-item-req-[0-9]{1,2}-[0-9]{1,3}(-[a-z0-9]+){1,5}$" },
        "deliver_to": {
          "type": "string",
          "pattern": "^assets-work/Items/requests/[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{1,2}-[0-9]{1,3}(-[a-z0-9]+){1,5}/delivery/$"
        },
        "push_allowed": {
          "type": "boolean",
          "description": "Set only by the owner. true records the owner's explicit authorization to push this branch and open a PR on vaskodagamo/MuMain; never to merge."
        },
        "claimed_by": { "type": ["string", "null"], "minLength": 1 },
        "claimed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
        "start_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/fullCommit" }] }
      }
    },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivered_at", "source_commits", "installed_files", "validation", "review_images", "notes", "pr_url"],
          "properties": {
            "delivered_at": { "$ref": "#/$defs/timestamp" },
            "source_commits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commit" } },
            "installed_files": {
              "type": "object",
              "description": "Game path -> delivered export it is byte-identical to.",
              "propertyNames": { "$ref": "#/$defs/gamePath" },
              "additionalProperties": { "$ref": "#/$defs/repoPath" }
            },
            "validation": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } },
            "review_images": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } },
            "notes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } },
            "pr_url": { "type": ["string", "null"], "pattern": "^https://github\\.com/vaskodagamo/MuMain/pull/[0-9]+$" }
          }
        }
      ]
    },
    "decision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "at", "by", "reason", "ledger_entry"],
          "properties": {
            "status": { "enum": ["accepted", "rejected", "withdrawn"] },
            "at": { "$ref": "#/$defs/timestamp" },
            "by": { "type": "string", "minLength": 1 },
            "reason": { "type": "string" },
            "ledger_entry": {
              "description": "requests/<id>/delivery when accepted, else null.",
              "type": ["string", "null"]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "open" } } },
      "then": {
        "properties": {
          "handoff": { "properties": { "claimed_by": { "type": "null" }, "claimed_at": { "type": "null" }, "start_commit": { "type": "null" } } },
          "result": { "type": "null" },
          "decision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "claimed" } } },
      "then": {
        "properties": {
          "handoff": { "properties": { "claimed_by": { "type": "string" }, "claimed_at": { "type": "string" }, "start_commit": { "type": "string" } } },
          "result": { "type": "null" },
          "decision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "delivered" } } },
      "then": {
        "properties": {
          "handoff": { "properties": { "claimed_by": { "type": "string" }, "claimed_at": { "type": "string" }, "start_commit": { "type": "string" } } },
          "result": { "type": "object" },
          "decision": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "properties": {
          "handoff": { "properties": { "claimed_by": { "type": "string" }, "claimed_at": { "type": "string" }, "start_commit": { "type": "string" } } },
          "result": { "type": "object" },
          "decision": { "type": "object", "properties": { "status": { "const": "accepted" }, "ledger_entry": { "type": "string" } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": { "properties": { "decision": { "type": "object", "properties": { "status": { "const": "rejected" }, "ledger_entry": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "withdrawn" } } },
      "then": { "properties": { "decision": { "type": "object", "properties": { "status": { "const": "withdrawn" }, "ledger_entry": { "type": "null" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "set" } } },
      "then": { "properties": { "targets": { "minItems": 2 }, "change": { "required": ["set_kind"] } } },
      "else": { "properties": { "change": { "not": { "required": ["set_kind"] } } } }
    }
  ],
  "$defs": {
    "status": { "enum": ["open", "claimed", "delivered", "accepted", "rejected", "withdrawn"] },
    "requestId": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{1,2}-[0-9]{1,3}(-[a-z0-9]+){1,5}$",
      "description": "<YYYY-MM-DD>-<item key>-<slug of one to five words>, e.g. 2026-09-23-0-0-sharper-blade; equals the folder name."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "fullCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "itemKey": { "type": "string", "pattern": "^[0-9]{1,2}-[0-9]{1,3}$" },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$",
      "description": "Relative to the repository root, forward slashes, no '..'."
    },
    "gamePath": { "type": "string", "pattern": "^src/bin/Data/(Item|Player)/.+\\.([bB][mM][dD]|[oO][zZ][jJtT])$" },
    "containerPath": { "type": "string", "pattern": "^src/bin/Data/[^/]+/.+\\.[oO][zZ][jJtT]$" },
    "bmdPath": { "type": "string", "pattern": "^src/bin/Data/(Item|Player)/.+\\.[bB][mM][dD]$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "bmd", "current_sha256", "textures"],
      "properties": {
        "role": { "enum": ["item", "class-variant", "left-hand", "right-hand", "inventory"] },
        "class": { "enum": ["dw", "dk", "elf", "mg", "dl", "sum", "rf"] },
        "bmd": { "$ref": "#/$defs/bmdPath" },
        "current_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "textures": {
          "type": "object",
          "description": "Texture name in the BMD -> container path, or null for hide* and unresolved names, as in catalog.json.",
          "additionalProperties": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/containerPath" }] }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "group", "index", "name", "family", "tier", "classes", "size", "models", "original"],
      "properties": {
        "key": { "$ref": "#/$defs/itemKey" },
        "group": { "type": "integer", "minimum": 0, "maximum": 15 },
        "index": { "type": "integer", "minimum": 0, "maximum": 511 },
        "name": { "type": ["string", "null"] },
        "family": { "type": "string", "minLength": 1 },
        "tier": { "type": "integer", "minimum": 1, "maximum": 7 },
        "classes": {
          "type": "object",
          "description": "Minimum class stage per class from the client table (0 = not usable).",
          "additionalProperties": false,
          "required": ["dw", "dk", "elf", "mg", "dl", "sum", "rf"],
          "properties": {
            "dw": { "type": "integer" }, "dk": { "type": "integer" }, "elf": { "type": "integer" },
            "mg": { "type": "integer" }, "dl": { "type": "integer" }, "sum": { "type": "integer" },
            "rf": { "type": "integer" }
          }
        },
        "size": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "items": false, "minItems": 2 },
        "armour_set": { "type": ["integer", "null"], "description": "Index of the armour set for groups 7-11, else null." },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "sha256"],
          "properties": {
            "revision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "variant", "view", "resolution", "client_commit"],
      "properties": {
        "file": { "type": "string", "pattern": "^assets-work/Items/requests/[^/]+/captures/(?!ref-)[^/]+\\.(jpg|jpeg)$" },
        "variant": { "enum": ["current", "original", "candidate"] },
        "view": { "enum": ["inventory", "ground", "equipped-front", "equipped-side", "turntable", "glow", "other"] },
        "angle": { "type": "number", "description": "Turntable angle in degrees." },
        "item_level": { "type": "integer", "minimum": 0, "maximum": 15 },
        "excellent": { "type": "boolean" },
        "ancient": { "type": "boolean" },
        "resolution": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{ "type": "integer", "minimum": 1, "maximum": 1920 }, { "type": "integer", "minimum": 1 }],
          "items": false
        },
        "client_commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] },
        "note": { "type": "string" }
      }
    }
  }
}
