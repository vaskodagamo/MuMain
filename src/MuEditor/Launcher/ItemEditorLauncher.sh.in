#!/bin/sh
# MU Item Editor: starts the game client in the Item Editor's studio
# ("Main --editor --items"). Generated by cmake/ItemEditorLauncher.cmake.
#
# The client reads Data/ relative to its working directory, so the script runs
# it from Main.app/Contents/MacOS: the Main.app next to this launcher, or else
# the one of the build that made it (for a copy moved to /Applications).

here="$(cd "$(dirname "$0")" && pwd)"
next_to_launcher="$here/../../../Main.app/Contents/MacOS"
built_with="$<TARGET_BUNDLE_CONTENT_DIR:Main>/MacOS"

for game in "$next_to_launcher" "$built_with"; do
    if [ -x "$game/Main" ]; then
        cd "$game" || exit 1
        exec ./Main --editor --items
    fi
done

osascript -e 'display alert "MU Item Editor" message "Main.app was not found next to MU Item Editor.app or in the build that made it. Build the macos-arm64-mueditor preset again."' >/dev/null 2>&1
exit 1
